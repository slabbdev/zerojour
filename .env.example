# --- Sanity dataset (seed import + GROQ mode) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# --- Sanity Context MCP (org token with Context Viewer permission) ---
# ONE endpoint serves ONE mode: a dataset-source endpoint serves GROQ tools
# and ignores KB sources. Create TWO endpoints in the Context app:
SANITY_ORG_ID=
SANITY_CONTEXT_ENDPOINT=zerojour        # dataset source (GROQ mode)
SANITY_CONTEXT_KB_ENDPOINT=zerojour-kb  # Knowledge Base source (KB mode)
SANITY_CONTEXT_TOKEN=

# --- Agent model: any OpenAI-compatible chat-completions endpoint ---
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_MODEL=gpt-4.1-mini

# --- NoireBox journal (local audit layer; optional but recommended) ---
NOIREBOX_URL=http://127.0.0.1:8768
NOIREBOX_CLIENT_ID=
NOIREBOX_CLIENT_SECRET=

# --- Optional: GitHub token to raise api.github.com rate limits ---
GITHUB_TOKEN=
