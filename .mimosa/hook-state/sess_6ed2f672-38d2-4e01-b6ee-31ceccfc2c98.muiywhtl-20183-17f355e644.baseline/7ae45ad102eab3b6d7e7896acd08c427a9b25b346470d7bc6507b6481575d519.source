{
  "name": "zerojour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A security-advisories agent that only works because the content is structured. Sanity Context (GROQ + Knowledge Base) vs a keyword-search baseline.",
  "scripts": {
    "fetch:advisories": "tsx seed/fetch-ghsa.ts",
    "seed": "tsx seed/import-sanity.ts",
    "agent": "tsx agent/src/main.ts",
    "ui": "tsx agent/src/main.ts serve-ui",
    "eval": "tsx eval/run.ts",
    "test": "tsx --test --test-force-exit --test-timeout=15000 tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@sanity/client": "^8.7.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/semver": "^7.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
